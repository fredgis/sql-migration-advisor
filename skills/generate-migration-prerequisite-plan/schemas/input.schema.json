{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fredgis/sql-migration-advisor/skills/generate-migration-prerequisite-plan/schemas/input.schema.json",
  "title": "Migration prerequisite plan input",
  "type": "object",
  "required": ["schemaVersion", "mode", "requestedOutput"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "enum": ["advisor_handoff", "standalone"] },
    "requestedOutput": { "enum": ["markdown", "json", "both"] },
    "language": { "type": "string", "minLength": 2 },
    "advisorOutput": { "type": ["object", "null"] },
    "standaloneSelection": {
      "type": ["object", "null"],
      "required": ["target", "method"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "tier": { "type": ["string", "null"] }
      }
    },
    "knownFacts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "source_version", "source_edition", "source_os", "source_location", "database_count",
          "largest_database_size_gb", "target_region", "target_tier", "source_permissions",
          "target_permissions", "downtime_tolerance", "rpo", "rto", "peak_change_rate",
          "performance_baseline_status", "tde_status", "authentication_model",
          "feature_inventory_status", "instance_object_inventory_status", "network_path_status",
          "dns_status", "validation_plan_status", "rollback_plan_status",
          "application_cutover_owner", "ha_migration_pattern", "source_ha_topology",
          "domain_model", "ag_endpoint_status", "quorum_status", "recovery_model",
          "backup_chain_status", "blob_https_status", "blob_access_model", "tde_material_status",
          "azure_migrate_platform", "azure_migrate_appliance_status", "test_migration_status",
          "hcx_service_mesh_status", "mi_link_ports_status", "mi_link_capacity_status",
          "lrs_window_days", "lrs_storage_layout_status", "schema_compatibility_status",
          "bacpac_consistency_status", "dms_runtime_status", "replication_primary_keys_status",
          "replication_topology", "data_box_device_status", "delta_sync_method",
          "striim_runtime_status", "fabric_capacity_status", "fabric_workspace_role",
          "fabric_gateway_type", "fabric_dacpac_size_mb", "arc_cluster_support_status",
          "arc_connectivity_mode", "arc_backup_storage_class_status", "arc_external_endpoint_status",
          "arc_restore_entrypoint", "container_image_status", "container_volume_status",
          "bulk_copy_tool", "bulk_target_schema_status", "adf_integration_runtime_status",
          "adf_connection_status"
        ]
      },
      "additionalProperties": {
        "anyOf": [
          { "enum": ["CONFIRMED", "MISSING", "UNKNOWN", "NOT_APPLICABLE"] },
          { "type": "string", "minLength": 1 },
          { "type": "number" },
          { "type": "integer" },
          { "type": "boolean" },
          { "type": "object" }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "collectedAt", "origin", "reference", "supports"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^EV-[0-9]{3,}$" },
          "type": { "type": "string", "minLength": 1 },
          "status": { "enum": ["reported", "verified"] },
          "collectedAt": { "type": "string", "format": "date-time" },
          "origin": { "type": "string", "minLength": 1 },
          "tool": { "type": ["string", "null"] },
          "toolVersion": { "type": ["string", "null"] },
          "reference": { "type": "string", "minLength": 1 },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(COM|P[0-9]{2})-[0-9]{3}$" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "advisor_handoff" } }
      },
      "then": {
        "required": ["advisorOutput"],
        "properties": { "advisorOutput": { "type": "object" } }
      }
    },
    {
      "if": {
        "required": ["mode"],
        "properties": { "mode": { "const": "standalone" } }
      },
      "then": {
        "required": ["standaloneSelection"],
        "properties": { "standaloneSelection": { "type": "object" } }
      }
    }
  ]
}

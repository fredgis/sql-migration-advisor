{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fredgis/sql-migration-advisor/skills/generate-migration-prerequisite-plan/schemas/input.schema.json",
  "title": "Migration prerequisite plan input",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "requestedOutput"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "advisor_handoff",
        "standalone"
      ]
    },
    "requestedOutput": {
      "enum": [
        "markdown",
        "json",
        "both"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "advisorOutput": {
      "$ref": "#/$defs/advisorOutput"
    },
    "standaloneSelection": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "target",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "controlPlane": {
          "enum": [
            "standalone",
            "azure-arc",
            "ssms-migration-component",
            "azure-migrate",
            "azure-dms",
            "fabric",
            "vmware-hcx"
          ],
          "description": "Which control plane runs the migration. It selects prerequisites rather than labelling them: azure-arc pulls in the extension, identity and batch requirements and changes which source-version matrix governs the method. Absent means standalone, and the plan says so rather than guessing."
        }
      }
    },
    "knownFacts": {
      "type": "object",
      "description": "Facts already established, keyed by question id. Every value is checked against the vocabulary or the type that question accepts, derived from questions.json. It used to be one open union of the readiness enum, any non-empty string, any number, any integer, a boolean and any object, so `tde_status: true`, `database_count: -5` and `mi_link_ports_status: \"BANANA\"` all validated and could then confirm a prerequisite. An unrecognised value is not a typed fact. Omitting a key means the question was never asked; the explicit UNKNOWN value means it was asked and not answered, and every enumerated field offers it so the two cases stay distinguishable.",
      "additionalProperties": false,
      "properties": {
        "source_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_edition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_os": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "database_count": {
          "type": "integer",
          "minimum": 1
        },
        "largest_database_size_gb": {
          "type": "number",
          "minimum": 0
        },
        "target_region": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_tier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_permissions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_permissions": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "downtime_tolerance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rpo": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rto": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "peak_change_rate": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "performance_baseline_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "tde_status": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authentication_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "feature_inventory_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "instance_object_inventory_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "network_path_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "dns_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "validation_plan_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "rollback_plan_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "application_cutover_owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ha_migration_pattern": {
          "enum": [
            "DISTRIBUTED_AG",
            "ALWAYS_ON_AG",
            "UNKNOWN"
          ]
        },
        "source_ha_topology": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "domain_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ag_endpoint_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "quorum_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "recovery_model": {
          "enum": [
            "FULL",
            "BULK_LOGGED",
            "SIMPLE",
            "UNKNOWN"
          ]
        },
        "backup_chain_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "blob_https_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "blob_access_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tde_material_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "azure_migrate_platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "azure_migrate_appliance_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "test_migration_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "hcx_service_mesh_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "mi_link_ports_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "mi_link_capacity_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "lrs_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "lrs_storage_layout_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "schema_compatibility_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "bacpac_consistency_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "dms_runtime_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "replication_primary_keys_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "replication_topology": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "data_box_device_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "delta_sync_method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "striim_runtime_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "fabric_capacity_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "fabric_workspace_role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fabric_gateway_type": {
          "enum": [
            "ON_PREMISES",
            "VNET_OR_PRIVATE_LINK",
            "UNKNOWN"
          ]
        },
        "fabric_dacpac_size_mb": {
          "type": "number",
          "minimum": 0
        },
        "arc_cluster_support_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "arc_connectivity_mode": {
          "enum": [
            "DIRECT",
            "INDIRECT",
            "UNKNOWN"
          ]
        },
        "arc_backup_storage_class_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "arc_external_endpoint_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "arc_restore_entrypoint": {
          "enum": [
            "DIRECT_POD_OR_STORAGE",
            "EXTERNAL_SQL_ENDPOINT",
            "UNKNOWN"
          ]
        },
        "container_image_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "container_volume_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "bulk_copy_tool": {
          "enum": [
            "BCP",
            "SMART_BULK_COPY",
            "UNKNOWN"
          ]
        },
        "bulk_target_schema_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "adf_integration_runtime_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "adf_connection_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "dms_migration_mode": {
          "enum": [
            "OFFLINE",
            "ONLINE",
            "UNKNOWN"
          ]
        },
        "dms_backup_landing_zone": {
          "enum": [
            "SMB_NETWORK_SHARE",
            "AZURE_BLOB_STORAGE",
            "UNKNOWN"
          ]
        },
        "recovery_model_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "avs_host_quota_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "avs_vcf_subscription_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "avs_address_plan_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "avs_interconnect_topology": {
          "enum": [
            "EXPRESSROUTE_GLOBAL_REACH",
            "AZURE_ROUTED_SOLUTION",
            "UNKNOWN"
          ]
        },
        "avs_outbound_internet_method": {
          "enum": [
            "MANAGED_SNAT",
            "PUBLIC_IP_NSX_EDGE",
            "AZURE_FIREWALL_DEFAULT_ROUTE",
            "NONE",
            "UNKNOWN"
          ]
        },
        "azure_migrate_project_access_status": {
          "enum": [
            "CONFIRMED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "azure_migrate_discovery_mode": {
          "enum": [
            "APPLIANCE",
            "COLLECTOR",
            "IMPORT",
            "ARC_ENABLED",
            "UNKNOWN"
          ]
        },
        "azure_migrate_source_platform": {
          "enum": [
            "VMWARE",
            "HYPERV",
            "PHYSICAL",
            "MIXED",
            "UNKNOWN"
          ]
        },
        "azure_migrate_intent": {
          "enum": [
            "ASSESS",
            "REPLICATE",
            "UNKNOWN"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "status",
          "collectedAt",
          "origin",
          "reference",
          "supports"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3,}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "reported",
              "verified"
            ]
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "toolVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(COM|P[0-9]{2})-[0-9]{3}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "advisor_handoff"
          }
        }
      },
      "then": {
        "required": [
          "advisorOutput"
        ],
        "properties": {
          "advisorOutput": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "standalone"
          }
        }
      },
      "then": {
        "required": [
          "standaloneSelection"
        ],
        "properties": {
          "standaloneSelection": {
            "type": "object"
          }
        }
      }
    }
  ],
  "$defs": {
    "advisorOutput": {
      "type": "object",
      "description": "The recommendation handed over by recommend-migration-path. It was previously typed as a bare object, which accepted anything: the contract between the two skills existed only in prose, so a producer change could not break a consumer test. Two shapes are documented and both are accepted here, because the Advisor renders one and the regression mirror emits the other. Whichever arrives, its vocabulary is checked against the same enums the Advisor's own schemas/output.schema.json declares, and the advisor-handoff-vocabulary gate fails the build if the two drift apart. Advisor fields remain context, not proof: no self-reported flag here can confirm an evidence-gated prerequisite. The type was briefly declared as object-or-null while both anyOf branches required an object, so null was advertised and rejected at the same time; an absent handoff is expressed by omitting the key, never by sending null.",
      "anyOf": [
        {
          "$ref": "#/$defs/advisorPublicOutput"
        },
        {
          "$ref": "#/$defs/advisorMirrorOutput"
        }
      ]
    },
    "advisorPublicOutput": {
      "type": "object",
      "required": [
        "metadata",
        "recommendation"
      ],
      "description": "The public contract shape of reference/output-contract.md section 2, as rendered for a reader and produced on request as JSON.",
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "recommendationStatus",
            "confidence"
          ],
          "properties": {
            "knowledgeBaseVersion": {
              "type": "string",
              "minLength": 1
            },
            "decisionRulesVersion": {
              "type": "string",
              "minLength": 1
            },
            "sourceCommit": {
              "type": "string",
              "minLength": 1
            },
            "evaluatedAt": {
              "type": "string",
              "minLength": 1
            },
            "recommendationStatus": {
              "$ref": "#/$defs/advisorRecommendationStatus"
            },
            "confidence": {
              "$ref": "#/$defs/advisorConfidence"
            }
          }
        },
        "normalizedProfile": {
          "type": "object"
        },
        "eligibilityTrace": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "$ref": "#/$defs/advisorTargetFamily"
              },
              "status": {
                "$ref": "#/$defs/advisorEligibilityStatus"
              },
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recommendation": {
          "type": "object",
          "required": [
            "target",
            "method",
            "controlPlane"
          ],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "targetAvailabilityDuringSync": {
              "$ref": "#/$defs/advisorTargetAvailability"
            },
            "businessCutoverDowntime": {
              "$ref": "#/$defs/advisorCutoverDowntime"
            },
            "controlPlane": {
              "enum": [
                "standalone",
                "azure-arc",
                "ssms-migration-component",
                "azure-migrate",
                "azure-dms",
                "fabric",
                "vmware-hcx"
              ],
              "description": "Which control plane runs the migration, carried over from the Advisor. It selects prerequisites rather than labelling them: azure-arc pulls in the extension, identity and batch requirements and changes which source-version matrix governs the method. Required, because a handoff that omits it silently produces a standalone plan for an Arc-orchestrated migration."
            }
          }
        },
        "alternative": {
          "type": "object"
        },
        "methodGateTrace": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "$ref": "#/$defs/advisorMethodGateStatus"
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "blockers": {
          "$ref": "#/$defs/advisorStatements"
        },
        "unknowns": {
          "$ref": "#/$defs/advisorStatements"
        },
        "assumptions": {
          "$ref": "#/$defs/advisorStatements"
        },
        "evidenceRequired": {
          "$ref": "#/$defs/advisorStatements"
        },
        "nextActions": {
          "$ref": "#/$defs/advisorStatements"
        },
        "evidenceLinks": {
          "$ref": "#/$defs/advisorStatements"
        },
        "largestRisk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "advisorMirrorOutput": {
      "type": "object",
      "required": [
        "primary_target",
        "method",
        "recommendationStatus",
        "confidence",
        "controlPlane"
      ],
      "description": "The flattened shape emitted by the Advisor's regression mirror and used by its golden scenarios. It carries the same decisions under different key names, so a plan can be built from a replayed scenario as well as from a live session.",
      "properties": {
        "eligibility": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/advisorTargetFamily"
          },
          "additionalProperties": {
            "$ref": "#/$defs/advisorEligibilityStatus"
          }
        },
        "primary_target": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "minLength": 1
        },
        "targetAvailabilityDuringSync": {
          "$ref": "#/$defs/advisorTargetAvailability"
        },
        "businessCutoverDowntime": {
          "$ref": "#/$defs/advisorCutoverDowntime"
        },
        "methodGateStatus": {
          "$ref": "#/$defs/advisorMethodGateStatus"
        },
        "recommendationStatus": {
          "$ref": "#/$defs/advisorRecommendationStatus"
        },
        "confidence": {
          "$ref": "#/$defs/advisorConfidence"
        },
        "controlPlane": {
          "enum": [
            "standalone",
            "azure-arc",
            "ssms-migration-component",
            "azure-migrate",
            "azure-dms",
            "fabric",
            "vmware-hcx"
          ],
          "description": "Which control plane runs the migration, mirrored from the Advisor. Required here for the same reason as in the public shape: an absent value produces a standalone plan for what may be an Arc-orchestrated migration."
        }
      }
    },
    "advisorRecommendationStatus": {
      "enum": [
        "provisional"
      ]
    },
    "advisorConfidence": {
      "enum": [
        "medium",
        "low"
      ]
    },
    "advisorEligibilityStatus": {
      "enum": [
        "eligible",
        "eligible_with_remediation",
        "unsupported",
        "excluded_by_preference",
        "unknown_requires_assessment"
      ]
    },
    "advisorTargetFamily": {
      "enum": [
        "sql_vm",
        "avs",
        "sql_mi",
        "sql_db",
        "fabric_sql_db",
        "arc_sql_mi",
        "container",
        "arc_in_place"
      ]
    },
    "advisorTargetAvailability": {
      "enum": [
        "read-write",
        "read-only",
        "unavailable",
        "not-present",
        "unknown_requires_assessment"
      ]
    },
    "advisorCutoverDowntime": {
      "enum": [
        "<1min",
        "near-zero",
        "minutes",
        "minimal",
        "hours",
        "full-restore-time",
        "full-load-time",
        "total-migration-time",
        "unknown_requires_assessment"
      ]
    },
    "advisorMethodGateStatus": {
      "enum": [
        "passed",
        "unknown_requires_assessment",
        "refused"
      ]
    },
    "advisorStatements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

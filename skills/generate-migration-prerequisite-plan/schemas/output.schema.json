{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fredgis/sql-migration-advisor/skills/generate-migration-prerequisite-plan/schemas/output.schema.json",
  "title": "Migration prerequisite plan output",
  "type": "object",
  "required": ["metadata", "overallStatus"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "prerequisiteKnowledgeBaseVersion", "pathCatalogVersion", "evaluatedAt", "mode", "language"],
      "additionalProperties": true,
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "prerequisiteKnowledgeBaseVersion": { "const": "v1.1" },
        "pathCatalogVersion": { "const": "1.0" },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "mode": { "enum": ["advisor_handoff", "standalone"] },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "selectedPath": {
      "type": "object",
      "required": ["id", "title", "target", "method", "supportStatus"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^P(0[1-9]|1[0-9]|2[0-8])$" },
        "title": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "tier": { "type": ["string", "null"] },
        "supportStatus": { "type": "string", "minLength": 1 }
      }
    },
    "overallStatus": { "enum": ["ready", "ready_with_conditions", "blocked", "unknown_requires_assessment", "unresolved_path"] },
    "summary": {
      "type": "object",
      "required": ["confirmed", "missing", "unknown", "notApplicable", "blockingMissing", "blockingUnknown"],
      "additionalProperties": false,
      "properties": {
        "confirmed": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "blockingMissing": { "type": "integer", "minimum": 0 },
        "blockingUnknown": { "type": "integer", "minimum": 0 }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "area", "title", "requirementType", "applicability", "status", "blocking", "owner", "basis", "evidenceRequired", "acceptedEvidence", "officialSources", "lastVerified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(COM|P[0-9]{2})-[0-9]{3}$" },
          "area": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "requirementType": { "enum": ["required", "conditional", "recommended"] },
          "applicability": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "missing", "unknown", "not_applicable"] },
          "blocking": { "type": "boolean" },
          "owner": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "evidenceRequired": { "type": "string", "minLength": 1 },
          "acceptedEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "officialSources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
          "lastVerified": { "type": "string", "format": "date" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "inheritedAdvisorFacts": { "type": "array", "items": { "type": "object" } },
    "questionsAsked": { "type": "array", "items": { "type": "object" } },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "sourceRegister": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "verifiedAt"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "verifiedAt": { "type": "string", "format": "date" }
        }
      }
    },
    "unresolvedReason": { "enum": ["no_matching_path", "multiple_candidate_paths", "ambiguous_disambiguation_answer"] },
    "candidatePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "target", "method"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P(0[1-9]|1[0-9]|2[0-8])$" },
          "title": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 }
        }
      }
    },
    "disambiguation": {
      "type": ["object", "null"],
      "required": ["field", "question", "allowedValues"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "allowedValues": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "overallStatus": { "const": "unresolved_path" } }, "required": ["overallStatus"] },
      "then": {
        "required": ["unresolvedReason", "candidatePaths", "disambiguation"],
        "not": {
          "anyOf": [
            { "required": ["selectedPath"] },
            { "required": ["prerequisites"] },
            { "required": ["summary"] },
            { "required": ["blockers"] },
            { "required": ["nextActions"] }
          ]
        }
      },
      "else": {
        "required": ["selectedPath", "summary", "prerequisites", "blockers", "unknowns", "assumptions", "questionsAsked", "nextActions", "sourceRegister"],
        "not": {
          "anyOf": [
            { "required": ["unresolvedReason"] },
            { "required": ["candidatePaths"] },
            { "required": ["disambiguation"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "metadata": { "properties": { "mode": { "const": "advisor_handoff" } }, "required": ["mode"] } },
        "required": ["metadata"]
      },
      "then": { "required": ["inheritedAdvisorFacts"] }
    }
  ]
}

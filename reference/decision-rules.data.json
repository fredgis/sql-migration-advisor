  "kbGuardsMirroredInRules": [
    {
      "name": "mi-link-linux-floor",
      "why": "Microsoft supports MI Link from Linux hosts starting with SQL Server 2017; only SQL Server 2016 is Windows Server only. v1.11 and earlier blocked every Linux source, which pushed a supported host to LRS and a far worse cutover. The rules pattern is anchored to the MI Link method row so the version appearing elsewhere does not satisfy the guard.",
      "knowledgeBase": "Linux from SQL Server 2017",
      "rules": "\\*\\*MI Link\\*\\* \\|[^\\n]*Linux from SQL Server 2017"
    },
    {
      "name": "mi-link-edition-gate",
      "why": "Same drift as the OS floor: the knowledge base named the supported editions and the tree did not gate on them.",
      "knowledgeBase": "Ent/Std/Dev",
      "rules": "\\*\\*MI Link\\*\\* \\|[^\\n]*Enterprise / Standard / Developer"
    },
    {
      "name": "lrs-30-day-window",
      "why": "The knowledge base stated the 30-day maximum window; the tree allowed LRS with no duration gate.",
      "knowledgeBase": "30-day max window",
      "rules": "\\*\\*Log Replay Service \\(LRS\\)\\*\\* standalone \\|[^\\n]*30-day maximum window"
    },
    {
      "name": "lrs-source-range-excludes-2025",
      "why": "LRS supports SQL Server 2008 to 2022. Without this in the tree, a blocked-ports fallback could select LRS for a 2025 source.",
      "knowledgeBase": "Standalone LRS: SQL Server 2008[–-]2022",
      "rules": "\\*\\*Log Replay Service \\(LRS\\)\\*\\* standalone \\|[^\\n]*not 2025"
    }
  ],

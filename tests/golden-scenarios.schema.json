{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fredgis/sql-migration-advisor/tests/golden-scenarios.schema.json",
  "title": "Golden scenarios",
  "description": "Shape of tests/golden-scenarios.json. These scenarios are edited by hand, and a mistyped key would otherwise disable a test silently instead of failing the build.",
  "type": "array",
  "minItems": 48,
  "items": { "$ref": "#/$defs/scenario" },

  "$defs": {
    "eligibilityStatus": {
      "enum": ["eligible", "eligible_with_remediation", "unsupported", "unknown_requires_assessment"]
    },

    "scenario": {
      "type": "object",
      "required": ["id", "title", "why", "inputs", "expect", "assertRulePresent", "auditRef"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Descriptive kebab-case identifier. Referenced by tests/required-scenarios.json."
        },
        "title": { "type": "string", "minLength": 1 },
        "why": {
          "type": "string",
          "minLength": 1,
          "description": "What this scenario protects. A scenario without a reason cannot be reviewed."
        },
        "inputs": { "$ref": "#/$defs/inputs" },
        "expect": { "$ref": "#/$defs/expect" },
        "assertRulePresent": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Sentences that must exist in reference/decision-rules.md and justify the outcome. Prefer plain text: an over-escaped pattern matches nothing and the assertion passes for the wrong reason."
        },
        "auditRef": {
          "type": "string",
          "minLength": 1,
          "description": "Where this scenario comes from: an audit finding such as P0-3, or a descriptive reference such as audit-mi-link-capacity-gp. Free-form on purpose, since scenarios arrive from audits, from regressions and from validation work."
        }
      }
    },

    "inputs": {
      "type": "object",
      "description": "What the interview would collect. Keys must match the normalized inputs declared in reference/decision-rules.md; branch-reachability checks that SKILL.md can actually collect each one.",
      "required": ["intent", "source_location", "source_version", "management_model", "feature_dependencies", "downtime"],
      "additionalProperties": false,
      "properties": {
        "intent": { "type": "string" },
        "driver": { "type": "string" },
        "source_location": { "type": "string" },
        "source_version": { "type": "string" },
        "source_os": { "type": "string" },
        "source_edition": { "type": "string" },
        "scope": { "type": "string" },
        "compliance": { "type": "string" },
        "network_bandwidth": { "type": "string" },
        "mi_link_ports": { "type": "string" },
        "blob_https_reachability": { "type": "string", "description": "Gates every backup-based path. BLOB_HTTPS_UNKNOWN must hold the method gate at unknown_requires_assessment rather than passed." },
        "clr_permission_set": { "type": "string" },
        "tde_status": { "type": "string" },
        "source_permissions": { "type": "string" },
        "authentication": { "type": "string" },
        "rpo": { "type": "string" },
        "rto": { "type": "string" },
        "target_region": { "type": "string" },
        "management_model": { "type": "string" },
        "kubernetes_model": { "type": "string" },
        "feature_dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Declared as a list, not prose, so rules can read subtypes such as PolyBase/external RDBMS directly."
        },
        "fabric_constraints": { "type": "string" },
        "downtime": { "type": "string" },
        "network_ports": { "type": "string" },
        "size": { "type": "string" },
        "tenant_count": { "type": "string" },
        "performance": {
          "type": ["string", "null"],
          "description": "null means the question was asked and left unanswered, which is not the same as absent."
        },
        "compliance": { "type": "string" },
        "database_count": { "type": "integer" },
        "migration_batch_size": { "type": "integer" },
        "arc_extension_version": { "type": "string" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dependenciesToolConfirmed": { "type": "boolean" },
            "performanceMeasured": { "type": "boolean" },
            "regionAvailabilityConfirmed": { "type": "boolean" },
            "architectSignedOff": { "type": "boolean" }
          }
        }
      }
    },

    "expect": {
      "type": "object",
      "required": ["primary_target", "method", "targetAvailabilityDuringSync", "businessCutoverDowntime", "recommendationStatus", "confidence"],
      "additionalProperties": false,
      "properties": {
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sql_vm": { "$ref": "#/$defs/eligibilityStatus" },
            "avs": { "$ref": "#/$defs/eligibilityStatus" },
            "sql_mi": { "$ref": "#/$defs/eligibilityStatus" },
            "sql_db": { "$ref": "#/$defs/eligibilityStatus" },
            "fabric_sql_db": { "$ref": "#/$defs/eligibilityStatus" },
            "arc_sql_mi": { "$ref": "#/$defs/eligibilityStatus" },
            "container": { "$ref": "#/$defs/eligibilityStatus" },
            "arc_in_place": { "$ref": "#/$defs/eligibilityStatus" }
          }
        },
        "primary_target": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "targetAvailabilityDuringSync": {
          "enum": ["read-write", "read-only", "unavailable", "not-present", "unknown_requires_assessment"]
        },
        "businessCutoverDowntime": {
          "enum": ["<1min", "near-zero", "minutes", "minimal", "hours", "full-restore-time", "full-load-time", "total-migration-time", "unknown_requires_assessment"]
        },
        "recommendationStatus": { "enum": ["provisional", "validated"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "mustNotRecommend": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Answers this scenario must never produce. Names the wrong outcome explicitly rather than trusting the right one to hold."
        },
        "capacityEligibility": { "$ref": "#/$defs/eligibilityStatus" },
        "arcWizardBatchEligibility": { "$ref": "#/$defs/eligibilityStatus" },
        "lrsBusinessCriticalCutoverCanTakeHours": { "type": "boolean" },
        "exclusions.mi_link": { "type": "string" },
        "exclusions.arc_wizard_batch": { "type": "string" },
        "exclusions.fabric_sql_db": { "type": "string" }
      }
    }
  }
}
